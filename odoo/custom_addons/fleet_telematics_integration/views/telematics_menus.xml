<?xml version="1.0" encoding="utf-8"?>
<!--
  views/telematics_menus.xml
  ไฟล์สร้างแถบเมนูหลักและเมนูย่อยของ Fleet Telematics

  แก้ 2026-08-05: จัดเมนู Dashboard/Reports ให้ตรงตาม FDD §12.6 เป๊ะๆ แล้ว
  (เดิมมีเมนูเกินสเปคปนอยู่ ทำให้ Dashboard กับ Reports ดูซ้ำซ้อนกัน —
  "Fuel & Energy Analysis" ซ้ำกับ "Fuel Efficiency Report", "Incentive
  Overview" ซ้ำกับ "Incentive Summary" ฯลฯ — ซ่อนเมนูที่เกินสเปคออกแล้ว
  ไม่ได้ลบ action/view ทิ้ง ดู comment แต่ละจุดในไฟล์นี้)

  Fleet Telematics (Root App)
  ├── Dashboard                     ← FDD §12.6: มีแค่ 2 อย่าง
  │   ├── Live Map                     (Fleet Live Map)
  │   └── KPI Summary                  (Driver Dashboard)
  ├── Trip Logs
  │   ├── Trip List                    (คลิกแถวไหนก็ได้ → เปิด Trip Detail
  │   │                                  Form + Map + Event list ให้เอง)
  │   └── Vehicle Trip History
  ├── Event Logs
  ├── Scoring Config
  ├── Incentive / Bonus
  ├── Reports                       ← FDD §12.6 ต้องการแค่ 1 อย่าง
  │   ├── Incentive Summary            (Pivot — ตรงสเปค)
  │   └── Backend Reports (ข้อมูลสด)   (เกินสเปค แต่เก็บไว้ตามที่ขอ)
  └── Settings
-->
<odoo>

    <!-- ═══════════════════════════════════════════════════════════════ -->
    <!--  Root App — Fleet Telematics                                   -->
    <!-- ═══════════════════════════════════════════════════════════════ -->
    <menuitem id="menu_fleet_telematics_root"
              name="Fleet Telematics"
              sequence="80"
              web_icon="fleet_telematics_integration,static/description/icon.png"/>

    <!-- ═══════════════════════════════════════════════════════════════ -->
    <!--  2.0 Devices — ปิดเมนูนี้แล้ว                                    -->
    <!--  เดิมแยกเป็นเมนูต่างหาก ทำให้มี 2 ทางผูก Device กับรถพร้อมกัน    -->
    <!--  (อีกทางคือแท็บ "Telematics Settings" ในฟอร์มรถ fleet.vehicle)  -->
    <!--  เสี่ยงข้อมูลขัดแย้งกัน — รวมเหลือทางเดียวในหน้ารถแทนแล้ว        -->
    <!--  โมเดล fleet.telematics.device ยังอยู่ในระบบ (ไม่ลบ เพื่อไม่ให้  -->
    <!--  Upgrade พังถ้ามีข้อมูลอยู่แล้ว) แค่ไม่แสดงเมนูอีกต่อไป          -->
    <!--
    <menuitem id="menu_telematics_devices"
              name="Devices"
              parent="menu_fleet_telematics_root"
              action="action_telematics_device"
              groups="fleet.fleet_group_manager"
              sequence="5"/>
    -->

    <!-- ═══════════════════════════════════════════════════════════════ -->
    <!--  2.1 Dashboard                                                  -->
    <!-- ═══════════════════════════════════════════════════════════════ -->
    <menuitem id="menu_telematics_dashboard"
              name="Dashboard"
              parent="menu_fleet_telematics_root"
              sequence="10"/>

    <!-- KPI Summary → Driver Dashboard OWL (FDD §12.6) -->
    <menuitem id="menu_telematics_dashboard_kpi"
              name="KPI Summary"
              parent="menu_telematics_dashboard"
              action="action_telematics_driver_dashboard"
              sequence="10"/>

    <!-- Fuel & Energy Analysis — ปิดเมนูนี้แล้ว (2026-08-05)
         ไม่มีใน FDD §12.6 เลย (ตาราง Views ที่ต้องพัฒนา กำหนดแค่ Driver
         Dashboard + Fleet Live Map สำหรับ Dashboard เท่านั้น) เพิ่มเข้ามา
         เกินสเปคทีหลัง ทับซ้อนกับ "Fuel Efficiency Report" ในเมนู Reports
         (ข้อมูลชุดเดียวกัน แค่มุมมอง group by ต่างกัน) — ไม่ลบ action/view
         ทิ้ง เผื่อยังอยากเอากลับมาใช้ทีหลัง แค่ซ่อนเมนูออก
    <menuitem id="menu_telematics_dashboard_fuel"
              name="Fuel &amp; Energy Analysis"
              parent="menu_telematics_dashboard"
              action="action_telematics_fuel_summary"
              sequence="20"/>
    -->

    <!-- Incentive Overview — ปิดเมนูนี้แล้ว (2026-08-05)
         ไม่มีใน FDD §12.6 เช่นกัน — สเปคมีแค่ "Incentive Summary" (Pivot)
         ในเมนู Reports เท่านั้น ไม่มี Dashboard แยกต่างหากสำหรับเรื่องนี้
         ทับซ้อนกับ "Incentive Summary" ในเมนู Reports (โมเดลเดียวกัน) -->
    <!--
    <menuitem id="menu_telematics_dashboard_incentive"
              name="Incentive Overview"
              parent="menu_telematics_dashboard"
              action="action_telematics_incentive_summary"
              sequence="30"/>
    -->

    <!-- Live Map (Real-time) — UC-06 (เพิ่มใหม่: เดิมไม่มี widget เลย) -->
    <record id="action_telematics_live_map" model="ir.actions.client">
        <field name="name">Live Map</field>
        <field name="tag">fleet_telematics_live_map</field>
    </record>
    <menuitem id="menu_telematics_dashboard_live_map"
              name="Live Map"
              parent="menu_telematics_dashboard"
              action="action_telematics_live_map"
              sequence="5"/>

    <!-- ═══════════════════════════════════════════════════════════════ -->
    <!--  2.2 Trip Logs                                                  -->
    <!-- ═══════════════════════════════════════════════════════════════ -->
    <menuitem id="menu_telematics_trip_logs"
              name="Trip Logs"
              parent="menu_fleet_telematics_root"
              sequence="20"/>

    <!-- Trip List — ตารางรวม + Sync Status -->
    <menuitem id="menu_telematics_trip_list"
              name="Trip List"
              parent="menu_telematics_trip_logs"
              action="action_telematics_log"
              sequence="10"/>

    <!-- Vehicle Trip History — ดึงสดจาก Backend GET /vehicles/{id}/trips -->
    <menuitem id="menu_telematics_vehicle_trip_history"
              name="Vehicle Trip History"
              parent="menu_telematics_trip_logs"
              action="action_telematics_vehicle_trip_history"
              sequence="15"/>

    <!-- "Trip Detail" (Form + Map(Leaflet) + Event list ตาม FDD §12.6) ไม่มี
         เมนูของตัวเอง — เข้าถึงได้อยู่แล้วโดยคลิกแถวไหนก็ได้ในเมนู "Trip
         List" ด้านบน (มาตรฐาน List→Form ของ Odoo) เคยลองทำเป็นเมนูแยก
         (view_mode="form,list") ไปก่อนหน้านี้แล้วพัง (เปิดเป็นฟอร์มเปล่าๆ
         แทนที่จะเป็นทริปจริง เพราะ Odoo ต้องมี record ID กำกับเสมอ) เอาออก
         แล้ว ไม่ต้องมีเมนูแยกสำหรับ Trip Detail อีก -->

    <!-- ═══════════════════════════════════════════════════════════════ -->
    <!--  2.3 Event Logs                                                 -->
    <!-- ═══════════════════════════════════════════════════════════════ -->
    <menuitem id="menu_telematics_event_logs"
              name="Event Logs"
              parent="menu_fleet_telematics_root"
              action="action_telematics_event"
              sequence="30"/>

    <!-- ═══════════════════════════════════════════════════════════════ -->
    <!--  2.4 Scoring Config                                             -->
    <!-- ═══════════════════════════════════════════════════════════════ -->
    <menuitem id="menu_telematics_scoring_config"
              name="Scoring Config"
              parent="menu_fleet_telematics_root"
              action="action_telematics_scoring_config"
              sequence="40"/>

    <!-- ═══════════════════════════════════════════════════════════════ -->
    <!--  2.5 Incentive / Bonus                                          -->
    <!-- ═══════════════════════════════════════════════════════════════ -->
    <menuitem id="menu_telematics_incentive"
              name="Incentive / Bonus"
              parent="menu_fleet_telematics_root"
              action="action_telematics_incentive"
              sequence="50"/>

    <!-- ═══════════════════════════════════════════════════════════════ -->
    <!--  2.6 Reports — Export PDF / Excel                               -->
    <!-- ═══════════════════════════════════════════════════════════════ -->
    <menuitem id="menu_telematics_reports"
              name="Reports"
              parent="menu_fleet_telematics_root"
              sequence="60"/>

    <!-- Driver Score Report / Fuel Efficiency Report / Fleet Summary /
         Fleet Summary — ปิดเมนูทั้ง 3 นี้แล้ว (2026-08-05)
         ไม่มีใน FDD §12.6 เลยสักตัว — สเปคกำหนดเมนู Reports ไว้แค่ 3 อย่าง:
         "Monthly Score Report" (PDF), "Energy Report" (PDF), และ
         "Incentive Summary" (Pivot) เท่านั้น ของ 3 อันนี้ซ้ำเนื้อหากับของที่
         มีอยู่แล้ว (Trip Logs, Incentive/Bonus) แค่ปรับมุมมอง group by
         ต่างกัน — ไม่ลบ action/view ทิ้ง เผื่อยังอยากเอากลับมาใช้ทีหลัง
         แค่ซ่อนเมนูออกเท่านั้น
    <menuitem id="menu_telematics_report_driver_score"
              name="Driver Score Report"
              parent="menu_telematics_reports"
              action="action_telematics_driver_score_report"
              sequence="10"/>
    <menuitem id="menu_telematics_report_fuel"
              name="Fuel Efficiency Report"
              parent="menu_telematics_reports"
              action="action_telematics_report_fuel_efficiency"
              sequence="20"/>
    <menuitem id="menu_telematics_report_fleet_summary"
              name="Fleet Summary"
              parent="menu_telematics_reports"
              action="action_telematics_report_fleet_summary"
              sequence="30"/>
    -->

    <!-- Backend Reports (ข้อมูลสด) — เอากลับมาแล้วตามที่ผู้ใช้ขอ
         (2026-08-05 รอบ 3) เคยซ่อนไปก่อนหน้านี้เพราะไม่มีในสเปค FDD แต่
         มีประโยชน์จริงตอนอยากเช็คข้อมูลสดจาก Backend โดยตรง (ไม่ผ่านข้อมูล
         sync ค้างใน Odoo) หรือใช้ debug ปัญหาการ sync เทียบข้อมูล 2 ฝั่ง -->
    <menuitem id="menu_telematics_report_backend_live"
              name="Backend Reports (ข้อมูลสด)"
              parent="menu_telematics_reports"
              action="action_telematics_backend_report"
              sequence="50"/>

    <!-- Monthly Score Report / Energy Report — ลบเมนูซ้ำออกแล้ว (2026-08-05
         รอบ 2) เดิมลองทำเป็นเมนูแยกในนี้ (ชี้ไป action เดียวกับ
         "Incentive / Bonus" และ "Trip List" ตามลำดับ) แต่กลายเป็นซ้ำซ้อน
         กับเมนูที่มีอยู่แล้ว — 2 หน้านี้พาไปที่ list เดียวกันเป๊ะ ผู้ใช้เลย
         งงว่าทำไมมี 2 เมนูโชว์ข้อมูลเหมือนกัน

         **ไม่ต้องมีเมนูแยกสำหรับ Monthly Score Report / Energy Report เลย
         เพราะปุ่ม Print ทั้งคู่ผูกไว้ผ่าน binding_model_id อยู่แล้ว จะโผล่
         ในเมนู Print อัตโนมัติทันทีที่เข้า:**
           - Monthly Score & Bonus Report → เข้าเมนู "Incentive / Bonus"
             เลือกใบโบนัส แล้วกด Print
           - Energy & Fuel Efficiency Report → เข้าเมนู "Trip Logs > Trip
             List" เลือกทริป แล้วกด Print
    -->

    <!-- Incentive Summary (FDD §12.6: Pivot วิเคราะห์โบนัสรายแผนก/เดือน/ปี)
         — ของเดิมตรงสเปคอยู่แล้ว เหลือเป็นรายการเดียวในเมนู Reports ตอนนี้
         (ตรงสเปคเป๊ะที่สุดแล้ว — มีแค่สิ่งที่ list/pivot ธรรมดาไม่มีให้ใช้
         อยู่ที่อื่น ไม่ซ้ำกับเมนูไหนเลย) -->
    <menuitem id="menu_telematics_report_incentive"
              name="Incentive Summary"
              parent="menu_telematics_reports"
              action="action_telematics_report_incentive_summary"
              sequence="30"/>

    <!-- Payload Inbox — ปิดเมนูแล้ว
         ไม่ได้อยู่ใน scope FDD เลยสักบรรทัด เป็นของที่ทีมเดิมเขียนทิ้งไว้
         ไม่ลบโมเดลทิ้งเผื่อมีข้อมูลอยู่แล้ว แค่ซ่อนเมนูออก
    <menuitem id="menu_telematics_payload_inbox"
              name="Payload Inbox"
              parent="menu_fleet_telematics_root"
              action="action_telematics_payload"
              groups="fleet.fleet_group_manager"
              sequence="95"/>
    -->

    <!-- ═══════════════════════════════════════════════════════════════ -->
    <!--  Settings — Fleet Telematics API Config                         -->
    <!-- ═══════════════════════════════════════════════════════════════ -->
    <!-- Settings — จำกัดเฉพาะ fleet_group_manager เท่านั้น (เดิมไม่มี groups=
         ทำให้ user ทั่วไปกดแล้วเจอ Access Error เพราะไม่มีสิทธิ์ในโมเดลนี้) -->
    <menuitem id="menu_telematics_settings"
              name="Settings"
              parent="menu_fleet_telematics_root"
              action="fleet_telematics_integration.action_open_telematics_config"
              groups="fleet.fleet_group_manager"
              sequence="99"/>

</odoo>
