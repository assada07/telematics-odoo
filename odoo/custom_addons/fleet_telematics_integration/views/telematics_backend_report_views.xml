<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_telematics_backend_report_form" model="ir.ui.view">
        <field name="name">fleet.telematics.backend.report.form</field>
        <field name="model">fleet.telematics.backend.report</field>
        <field name="arch" type="xml">
            <form string="Backend Reports (ข้อมูลสด)">
                <sheet>

                    <!-- ── หัวข้อหน้า ─────────────────────────────────── -->
                    <div class="d-flex align-items-center mb-3">
                        <i class="fa fa-bar-chart fa-2x text-primary me-3"/>
                        <div>
                            <h2 class="mb-0">Fleet Telematics Reports</h2>
                            <span class="text-muted">
                                ดึงรายงานสดจาก Backend โดยตรง ไม่คำนวณซ้ำฝั่ง Odoo
                                — กดปุ่มด้านล่างเพื่อดึงข้อมูลล่าสุด
                            </span>
                        </div>
                    </div>

                    <!-- ── เลือก Driver (ใช้ร่วมกับกลุ่มรายงานรายคนด้านล่าง) ── -->
                    <div class="card mb-3">
                        <div class="card-body py-3">
                            <div class="d-flex align-items-center gap-3 flex-wrap">
                                <i class="fa fa-user-circle fa-lg text-secondary"/>
                                <field name="driver_id" placeholder="เลือก Driver..."
                                       class="oe_inline"
                                       style="min-width: 280px;"
                                       help="เลือก Driver สำหรับรายงานรายคน — เว้นว่างสำหรับรายงานทั้งฟลีท"/>
                                <span class="badge rounded-pill text-bg-success" invisible="not driver_id">
                                    <i class="fa fa-check"/> พร้อมดึงรายงานรายคนแล้ว
                                </span>
                                <span class="badge rounded-pill text-bg-light text-muted border" invisible="driver_id">
                                    ยังไม่ได้เลือก Driver — ใช้ได้เฉพาะรายงานภาพรวม Fleet ด้านล่าง
                                </span>
                            </div>
                        </div>
                    </div>

                    <!-- ── กลุ่ม 1: รายงานภาพรวม Fleet ──────────────────── -->
                    <div class="card mb-3 border-start border-primary border-4">
                        <div class="card-body">
                            <h5 class="d-flex align-items-center gap-2 mb-1">
                                <i class="fa fa-truck text-primary"/>
                                รายงานภาพรวม Fleet
                            </h5>
                            <p class="text-muted mb-3">
                                ดูภาพรวมทั้งฟลีทพร้อมกัน — ไม่ต้องเลือก Driver
                            </p>
                            <div class="d-flex flex-wrap gap-2">
                                <button name="action_fetch_fleet_summary"
                                        type="object" class="btn btn-primary">
                                    <i class="fa fa-th-large me-1"/> Fleet Summary
                                    <span class="d-block small fw-normal opacity-75">ภาพรวม Fleet รายวัน</span>
                                </button>
                                <button name="action_fetch_all_driver_scores"
                                        type="object" class="btn btn-outline-primary">
                                    <i class="fa fa-list-ol me-1"/> Driver Score
                                    <span class="d-block small fw-normal opacity-75">คะแนนขับขี่ทุกคน</span>
                                </button>
                                <button name="action_fetch_maintenance_forecast"
                                        type="object" class="btn btn-outline-warning">
                                    <i class="fa fa-wrench me-1"/> Maintenance Forecast
                                    <span class="d-block small fw-normal opacity-75">พยากรณ์ซ่อมบำรุง</span>
                                </button>
                                <button name="action_fetch_fuel_efficiency"
                                        type="object" class="btn btn-outline-primary">
                                    <i class="fa fa-tint me-1"/> Fuel Efficiency
                                    <span class="d-block small fw-normal opacity-75">ประสิทธิภาพน้ำมันทั้งฟลีท</span>
                                </button>
                            </div>
                        </div>
                    </div>

                    <!-- ── กลุ่ม 2: รายงานรายคน ──────────────────────────── -->
                    <div class="card mb-3 border-start border-secondary border-4">
                        <div class="card-body">
                            <h5 class="d-flex align-items-center gap-2 mb-1">
                                <i class="fa fa-user text-secondary"/>
                                รายงานรายคน
                            </h5>
                            <p class="text-muted mb-3">
                                ต้องเลือก Driver ที่ช่องด้านบนก่อนถึงจะกดปุ่มด้านล่างได้
                            </p>
                            <div class="d-flex flex-wrap gap-2">
                                <button name="action_fetch_driver_score_single"
                                        type="object" class="btn btn-outline-secondary">
                                    <i class="fa fa-star me-1"/> Driver Score
                                    <span class="d-block small fw-normal opacity-75">คะแนนของคนนี้</span>
                                </button>
                                <button name="action_fetch_driver_events"
                                        type="object" class="btn btn-outline-secondary">
                                    <i class="fa fa-exclamation-triangle me-1"/> Harsh Events
                                    <span class="d-block small fw-normal opacity-75">ประวัติพฤติกรรมเสี่ยง</span>
                                </button>
                                <button name="action_fetch_fuel_summary"
                                        type="object" class="btn btn-outline-secondary">
                                    <i class="fa fa-tint me-1"/> Fuel Summary
                                    <span class="d-block small fw-normal opacity-75">สรุปการใช้น้ำมันของคนนี้</span>
                                </button>
                            </div>
                        </div>
                    </div>

                    <!-- ── ผลลัพธ์ ───────────────────────────────────────── -->
                    <div invisible="not result_html">
                        <hr class="my-4"/>
                        <h5 class="d-flex align-items-center gap-2 mb-3">
                            <i class="fa fa-table text-success"/>
                            ผลลัพธ์ล่าสุด
                        </h5>
                        <div class="card">
                            <div class="card-body">
                                <field name="result_html" widget="html" nolabel="1"/>
                            </div>
                        </div>
                    </div>

                </sheet>
                <footer>
                    <button string="ย้อนกลับ" class="btn btn-secondary" special="cancel">
                        <i class="fa fa-arrow-left me-1"/> ย้อนกลับ
                    </button>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_telematics_backend_report" model="ir.actions.act_window">
        <field name="name">Backend Reports (ข้อมูลสด)</field>
        <field name="res_model">fleet.telematics.backend.report</field>
        <field name="view_mode">form</field>
        <field name="target">current</field>
    </record>

</odoo>
